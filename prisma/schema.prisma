// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member") // "admin" | "member"
  status       String   @default("active") // "active" | "suspended"
  jiraEmail    String?
  jiraApiToken String? // encrypted, see src/lib/crypto.ts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Single row (id = 1) holding settings shared by every user.
model AppSettings {
  id         Int     @id @default(1)
  jiraDomain String?
}
