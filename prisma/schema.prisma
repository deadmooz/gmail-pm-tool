// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  emails        Email[]
  issues        Issue[]
  settings      Settings?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model Email {
  id          String   @id @default(cuid())
  messageId   String   @unique
  threadId    String
  sender      String
  date        DateTime
  subject     String
  body        String   
  status      String @default("UNPROCESSED")
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues      IssueEmail[]
  jiraMappings JiraMapping[]
}

model Issue {
  id           String   @id @default(cuid())
  type         String
  title        String
  description  String   
  status       String @default("NEW")
  severity     String?
  priority     String?
  productArea  String?
  aiConfidence Float?
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       IssueEmail[]
  jiraMappings JiraMapping[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model IssueEmail {
  issueId String
  emailId String
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  email   Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@id([issueId, emailId])
}

model Settings {
  id               String   @id @default(cuid())
  userId           String   @unique
  relevantKeywords String   @default("[]") // Stored as JSON string array
  vipEmails        String   @default("[]") // Stored as JSON string array
  jiraDomain       String?
  jiraEmail        String?
  jiraApiToken     String?
  jiraBugJql       String?
  jiraTaskJql      String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JiraMapping {
  id             String   @id @default(cuid())
  jiraIssueKey   String
  jiraProjectKey String?
  issueId        String?
  emailId        String?
  issue          Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  email          Email?   @relation(fields: [emailId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@unique([jiraIssueKey, issueId])
  @@unique([jiraIssueKey, emailId])
}
